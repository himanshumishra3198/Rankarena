# Local development settings for the backend. Copy to backend/.env:
#   cp backend/.env.example backend/.env
# Everything below the "Optional" line can stay unset locally.

# Matches the root .env used by docker-compose.yml.
DATABASE_URL="postgresql://postgres:password@localhost:5432/rankarena"
REDIS_URL="redis://localhost:6379"

# Any long random string. The server refuses to start with the old
# placeholder. Generate your own with: openssl rand -hex 32
JWT_SECRET="local-dev-only-replace-with-openssl-rand-hex-32"

PORT=4000
# Student app (5173) and admin panel (5174).
CORS_ORIGIN="http://localhost:5173,http://localhost:5174"
# Base URL for links in verification and password-reset emails.
PUBLIC_SITE_URL="http://localhost:5173"

# ── Optional ────────────────────────────────────────────────────────────────

# Email. Unset means nothing is sent and each email, including its link, is
# printed to the backend console instead.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=
# MAIL_REPLY_TO=

# Google sign-in. Must be the same client id as VITE_GOOGLE_CLIENT_ID in
# frontend/.env. Unset means only email/password login works.
# GOOGLE_CLIENT_ID=

# Image uploads in the admin question editor. Unset means uploads fail with
# "Image storage is not configured"; everything else works.
# S3_BUCKET=
# S3_REGION=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
