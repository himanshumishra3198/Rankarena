generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(uuid())
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         Role     @default(STUDENT)
  rating       Int      @default(1500)
  createdAt    DateTime @default(now()) @map("created_at")

  participations  Participation[]
  ratingHistory   RatingHistory[]
  mockAttempts    MockAttempt[]
  questionReports QuestionReport[]
  bookmarks       Bookmark[]
  following       Follow[]         @relation("UserFollowing")
  followers       Follow[]         @relation("UserFollowers")
  articles        Article[]
  articleComments ArticleComment[]
  articleVotes    ArticleVote[]
  commentVotes    CommentVote[]

  @@map("users")
}

// A community post — contest announcements, technique write-ups, editorials.
// `score` and `commentCount` are denormalized so the list page can sort by
// popularity without aggregating votes/comments on every request; both are
// kept in step with their source tables inside a transaction.
model Article {
  id           String      @id @default(uuid())
  authorId     String      @map("author_id")
  title        String
  body         String
  type         ArticleType @default(GENERAL)
  pinned       Boolean     @default(false)
  score        Int         @default(0)
  commentCount Int         @default(0)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    ArticleVote[]
  comments ArticleComment[]

  @@index([createdAt])
  @@index([score])
  @@index([authorId])
  @@map("articles")
}

// Threaded comment. Replies point at their parent, so a thread is rebuilt by
// nesting on `parentId`. Deletes are soft (body blanked, `deleted` set) so a
// removed parent doesn't orphan the replies underneath it.
model ArticleComment {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  body      String
  score     Int      @default(0)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article  Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ArticleComment[] @relation("CommentReplies")
  votes    CommentVote[]

  @@index([articleId])
  @@index([parentId])
  @@map("article_comments")
}

// value is +1 or -1. One row per user per article; voting the same way twice
// deletes the row (unvote), matching Codeforces' toggle behaviour.
model ArticleVote {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("article_votes")
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_votes")
}

// A student's saved question for later revision.
model Bookmark {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("bookmarks")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@map("follows")
}

model Contest {
  id              String        @id @default(uuid())
  title           String
  startTime       DateTime      @map("start_time")
  durationMinutes Int           @map("duration_minutes")
  negativeMarks   Decimal       @default(0.5) @map("negative_marks")
  sectionLimits   Json?         @map("section_limits") // { QUANT: 25, REASONING: 20, ENGLISH: 25, GK: 20 }
  status          ContestStatus @default(SCHEDULED)
  createdAt       DateTime      @default(now()) @map("created_at")

  contestQuestions ContestQuestion[]
  participations   Participation[]
  ratingHistory    RatingHistory[]

  @@map("contests")
}

// Passage groups related questions (reading comprehension or data table)
model Passage {
  id        String      @id @default(uuid())
  title     String      @default("")
  content   String      // passage text, or description for table type
  type      PassageType @default(TEXT)
  tableData Json?       @map("table_data") // { headers: string[], rows: string[][] }
  createdAt DateTime    @default(now()) @map("created_at")

  questions Question[]

  @@map("passages")
}

model Question {
  id             String       @id @default(uuid())
  questionType   QuestionType @default(STANDARD) @map("question_type")
  text           String
  imageUrl       String?      @map("image_url")
  optionA        String       @map("option_a")
  optionB        String       @map("option_b")
  optionC        String       @map("option_c")
  optionD        String       @map("option_d")
  correctOption  String       @map("correct_option")
  subject        Subject
  difficulty     Difficulty   @default(MEDIUM)
  passageId      String?      @map("passage_id")
  structuredData Json?        @map("structured_data") // for SYLLOGISM: { statements: string[], conclusions: string[] }
  solution       String?      // rich-text detailed solution / explanation (HTML)
  fingerprint    String?      // normalized hash of text + options, for exact-duplicate detection

  passage           Passage?            @relation(fields: [passageId], references: [id])
  contestQuestions  ContestQuestion[]
  mockTestQuestions MockTestQuestion[]
  reports           QuestionReport[]
  bookmarks         Bookmark[]

  @@index([fingerprint])
  @@map("questions")
}

// Student-submitted flag on a question (wrong answer, typo, etc.). Admins
// triage these to keep the question bank clean.
model QuestionReport {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  userId     String       @map("user_id")
  reason     ReportReason
  details    String?
  source     String? // where it was reported from, e.g. "mock:<id>" or "contest:<id>"
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("question_reports")
}

// Sectional (subject-wise) practice mock test — always available, no rating.
model MockTest {
  id              String   @id @default(uuid())
  title           String
  subject         Subject
  durationMinutes Int      @map("duration_minutes")
  negativeMarks   Decimal  @default(0.5) @map("negative_marks")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")

  mockTestQuestions MockTestQuestion[]
  attempts          MockAttempt[]

  @@map("mock_tests")
}

model MockTestQuestion {
  mockTestId    String  @map("mock_test_id")
  questionId    String  @map("question_id")
  displayOrder  Int     @map("display_order")
  marks         Decimal @default(2)
  negativeMarks Decimal @default(0.5) @map("negative_marks")

  mockTest MockTest @relation(fields: [mockTestId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([mockTestId, questionId])
  @@map("mock_test_questions")
}

model MockAttempt {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  mockTestId   String    @map("mock_test_id")
  score        Decimal   @default(0)
  totalMarks   Decimal   @default(0) @map("total_marks")
  correctCount Int       @default(0) @map("correct_count")
  wrongCount   Int       @default(0) @map("wrong_count")
  skippedCount Int       @default(0) @map("skipped_count")
  answers      Json?
  timeSpent    Json?     @map("time_spent")
  markedForReview Json?  @map("marked_for_review") // array of question IDs flagged in the room
  startedAt    DateTime  @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")

  user     User     @relation(fields: [userId], references: [id])
  mockTest MockTest @relation(fields: [mockTestId], references: [id])

  @@unique([userId, mockTestId])
  @@map("mock_attempts")
}

model ContestQuestion {
  contestId     String  @map("contest_id")
  questionId    String  @map("question_id")
  displayOrder  Int     @map("display_order")
  marks         Decimal @default(2)
  negativeMarks Decimal @default(0.5) @map("negative_marks")

  contest  Contest  @relation(fields: [contestId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([contestId, questionId])
  @@map("contest_questions")
}

model Participation {
  id           String    @id @default(uuid())
  userId       String    @map("user_id")
  contestId    String    @map("contest_id")
  score        Decimal   @default(0)
  draftAnswers Json?     @default("{}") @map("draft_answers")
  answers      Json?
  timeSpent    Json?     @map("time_spent")
  markedForReview Json?  @map("marked_for_review") // array of question IDs flagged in the room
  startedAt    DateTime  @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  @@unique([userId, contestId])
  @@map("participations")
}

model RatingHistory {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  contestId         String   @map("contest_id")
  oldRating         Int      @map("old_rating")
  newRating         Int      @map("new_rating")
  rank              Int
  totalParticipants Int      @map("total_participants")
  createdAt         DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  @@unique([userId, contestId])
  @@map("rating_history")
}

enum Role {
  STUDENT
  ADMIN
}

enum ContestStatus {
  SCHEDULED
  LIVE
  ENDED
}

enum Subject {
  QUANT
  REASONING
  ENGLISH
  GK
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestionType {
  STANDARD
  SYLLOGISM
  PASSAGE
  TABLE
}

enum ReportReason {
  WRONG_ANSWER
  TYPO
  UNCLEAR
  MULTIPLE_CORRECT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum ArticleType {
  GENERAL
  ANNOUNCEMENT
  TECHNIQUE
  EDITORIAL
}

enum PassageType {
  TEXT
  TABLE
}
