generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id    String @id @default(uuid())
  name  String
  email String @unique
  // Null for accounts created through Google, which have no password of ours.
  // Such an account gains one only by going through the reset-password flow.
  passwordHash String? @map("password_hash")
  // Google's subject claim. Stable per account, and not the email — Google
  // lets people change their address, so matching on it would be wrong.
  googleId  String? @unique @map("google_id")
  avatarUrl String? @map("avatar_url")
  // Existing accounts were backfilled true: they predate verification and
  // locking them out of contests would be a regression, not a fix.
  emailVerified Boolean  @default(false) @map("email_verified")
  // Contest announcements and start reminders. Defaults on — someone who
  // registered for a contest expects to hear about it — and every such email
  // carries a one-click unsubscribe that flips this.
  contestEmails Boolean  @default(true) @map("contest_emails")
  role          Role     @default(STUDENT)
  rating        Int      @default(1500)
  createdAt     DateTime @default(now()) @map("created_at")

  participations  Participation[]
  ratingHistory   RatingHistory[]
  mockAttempts    MockAttempt[]
  questionReports QuestionReport[]
  bookmarks       Bookmark[]
  following       Follow[]         @relation("UserFollowing")
  followers       Follow[]         @relation("UserFollowers")
  articles        Article[]
  articleComments ArticleComment[]
  articleVotes    ArticleVote[]
  commentVotes    CommentVote[]
  notifications   Notification[]   @relation("NotificationRecipient")
  actedNotifications Notification[] @relation("NotificationActor")
  authTokens      AuthToken[]

  @@map("users")
}

// One-shot links mailed to a user: "confirm this address", "reset this
// password".
//
// Only the SHA-256 of the token is stored. The raw value exists in the email
// and nowhere else, so a dump of this table cannot be replayed into an account
// takeover. Rows are single-use (usedAt) and expire; superseded ones are
// cleared when a new token of the same type is issued.
model AuthToken {
  id        String        @id @default(uuid())
  userId    String        @map("user_id")
  type      AuthTokenType
  tokenHash String        @unique @map("token_hash")
  expiresAt DateTime      @map("expires_at")
  usedAt    DateTime?     @map("used_at")
  createdAt DateTime      @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("auth_tokens")
}

enum AuthTokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
}

// One row per thing a user should be told about.
//
// `actorId` is whoever caused it — the follower, the voter — and is null for
// system-wide notices like announcements. The target columns are nullable
// because which one applies depends on `type`; only one is ever set.
//
// Votes upsert on (userId, actorId, type, target) so that toggling a vote
// updates the existing row instead of piling up a new notification each time.
model Notification {
  id        String           @id @default(uuid())
  userId    String           @map("user_id")
  type      NotificationType
  actorId   String?          @map("actor_id")
  articleId String?          @map("article_id")
  commentId String?          @map("comment_id")
  // Copied from the vote so the text can say "upvoted" or "downvoted" without
  // reading back a vote row that may since have been cleared.
  voteValue Int?             @map("vote_value")
  // Which contest this is about, for the two contest types. Postgres treats
  // NULLs as distinct, so the compound unique below does not actually dedupe
  // rows whose target columns are null — that is why the social types are
  // upserted by hand. Contest notifications get a real guarantee instead, from
  // a partial unique index on (user, type, contest) added in the migration.
  contestId String?          @map("contest_id")
  read      Boolean          @default(false)
  createdAt DateTime         @default(now()) @map("created_at")

  user    User     @relation("NotificationRecipient", fields: [userId], references: [id], onDelete: Cascade)
  actor   User?    @relation("NotificationActor", fields: [actorId], references: [id], onDelete: Cascade)
  contest Contest? @relation(fields: [contestId], references: [id], onDelete: Cascade)

  // Refined in SQL to a partial index over social notifications only
  // (WHERE contest_id IS NULL). It is NULLS NOT DISTINCT, so without that
  // narrowing it collapses to (userId, type) for contest rows and admits one
  // per user for all time. See 20260913000000_contest_notifications.
  @@unique([userId, actorId, type, articleId, commentId])
  @@index([userId, read])
  @@index([userId, createdAt])
  @@map("notifications")
}

// A community post — contest announcements, technique write-ups, editorials.
// `score` and `commentCount` are denormalized so the list page can sort by
// popularity without aggregating votes/comments on every request; both are
// kept in step with their source tables inside a transaction.
model Article {
  id           String      @id @default(uuid())
  authorId     String      @map("author_id")
  title        String
  body         String
  type         ArticleType @default(GENERAL)
  pinned       Boolean     @default(false)
  score        Int         @default(0)
  commentCount Int         @default(0)
  createdAt    DateTime    @default(now()) @map("created_at")
  updatedAt    DateTime    @updatedAt @map("updated_at")

  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  votes    ArticleVote[]
  comments ArticleComment[]

  @@index([createdAt])
  @@index([score])
  @@index([authorId])
  @@map("articles")
}

// Threaded comment. Replies point at their parent, so a thread is rebuilt by
// nesting on `parentId`. Deletes are soft (body blanked, `deleted` set) so a
// removed parent doesn't orphan the replies underneath it.
model ArticleComment {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  authorId  String   @map("author_id")
  parentId  String?  @map("parent_id")
  body      String
  score     Int      @default(0)
  deleted   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  article  Article          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  author   User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  parent   ArticleComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies  ArticleComment[] @relation("CommentReplies")
  votes    CommentVote[]

  @@index([articleId])
  @@index([parentId])
  @@map("article_comments")
}

// value is +1 or -1. One row per user per article; voting the same way twice
// deletes the row (unvote), matching Codeforces' toggle behaviour.
model ArticleVote {
  id        String   @id @default(uuid())
  articleId String   @map("article_id")
  userId    String   @map("user_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([articleId])
  @@map("article_votes")
}

model CommentVote {
  id        String   @id @default(uuid())
  commentId String   @map("comment_id")
  userId    String   @map("user_id")
  value     Int
  createdAt DateTime @default(now()) @map("created_at")

  comment ArticleComment @relation(fields: [commentId], references: [id], onDelete: Cascade)
  user    User           @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([commentId, userId])
  @@index([commentId])
  @@map("comment_votes")
}

// A student's saved question for later revision.
model Bookmark {
  id         String   @id @default(uuid())
  userId     String   @map("user_id")
  questionId String   @map("question_id")
  createdAt  DateTime @default(now()) @map("created_at")

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([userId, questionId])
  @@index([userId])
  @@map("bookmarks")
}

model Follow {
  id          String   @id @default(uuid())
  followerId  String   @map("follower_id")
  followingId String   @map("following_id")
  createdAt   DateTime @default(now()) @map("created_at")

  follower  User @relation("UserFollowing", fields: [followerId], references: [id])
  following User @relation("UserFollowers", fields: [followingId], references: [id])

  @@unique([followerId, followingId])
  @@map("follows")
}

model Contest {
  id              String        @id @default(uuid())
  title           String
  startTime       DateTime      @map("start_time")
  durationMinutes Int           @map("duration_minutes")
  negativeMarks   Decimal       @default(0.5) @map("negative_marks")
  // Keyed by Subject, so a CAT paper is { VARC: 24, DILR: 20, QA: 22 } and an
  // SSC one { QUANT: 25, REASONING: 20, ENGLISH: 25, GK: 20 }. The sections
  // legal for a given exam come from examSections().
  sectionLimits   Json?         @map("section_limits")
  exam            Exam          @default(SSC_CGL)
  status          ContestStatus @default(SCHEDULED)
  // When the "a new contest is scheduled" mail went out. Null means it has not
  // been announced yet, which is what the sweep looks for — so a crash halfway
  // through a send is picked up on the next pass instead of being lost or
  // repeated.
  announcedAt     DateTime?     @map("announced_at")
  createdAt       DateTime      @default(now()) @map("created_at")

  contestQuestions ContestQuestion[]
  participations   Participation[]
  ratingHistory    RatingHistory[]
  notifications    Notification[]

  @@map("contests")
}

// Passage groups related questions (reading comprehension or data table)
model Passage {
  id        String      @id @default(uuid())
  title     String      @default("")
  content   String      // passage text, or description for table type
  type      PassageType @default(TEXT)
  tableData Json?       @map("table_data") // { headers: string[], rows: string[][] }
  createdAt DateTime    @default(now()) @map("created_at")

  questions    Question[]
  translations PassageTranslation[]

  @@map("passages")
}

model Question {
  id             String       @id @default(uuid())
  questionType   QuestionType @default(STANDARD) @map("question_type")
  text           String
  imageUrl       String?      @map("image_url")
  // Options are blank for TITA, which has none. They stay non-null so that
  // every existing row, query and translation keeps working untouched.
  optionA        String       @default("") @map("option_a")
  optionB        String       @default("") @map("option_b")
  optionC        String       @default("") @map("option_c")
  optionD        String       @default("") @map("option_d")
  // The key for single-choice questions, and null for MSQ and TITA, whose
  // answers do not fit in one letter and live in `answerConfig` instead.
  // Nullable rather than overloaded: a comma-joined "A,C" here would be read
  // as a literal option by every comparison already written against it.
  correctOption  String?      @map("correct_option")
  // MSQ: { correct: ["A","C"], partial: false }
  // TITA: { kind: "NUMERIC"|"TEXT", accepted: ["12","12.0"], tolerance: 0.01 }
  // Null for single-choice. Shapes are parsed and validated in
  // src/lib/answers.ts — nothing reads this Json directly.
  answerConfig   Json?        @map("answer_config")
  exam           Exam         @default(SSC_CGL)
  subject        Subject
  // Optional syllabus topic, validated against src/lib/topics.ts rather than
  // an enum so the list can change without a migration.
  topic          String?
  difficulty     Difficulty   @default(MEDIUM)
  passageId      String?      @map("passage_id")
  structuredData Json?        @map("structured_data") // for SYLLOGISM: { statements: string[], conclusions: string[] }
  solution       String?      // rich-text detailed solution / explanation (HTML)
  fingerprint    String?      // normalized hash of text + options, for exact-duplicate detection

  translations      QuestionTranslation[]

  passage           Passage?            @relation(fields: [passageId], references: [id])
  contestQuestions  ContestQuestion[]
  mockTestQuestions MockTestQuestion[]
  reports           QuestionReport[]
  bookmarks         Bookmark[]
  tags              QuestionTag[]

  @@index([fingerprint])
  @@index([subject, topic])
  @@index([exam, subject])
  @@map("questions")
}

// Student-submitted flag on a question (wrong answer, typo, etc.). Admins
// triage these to keep the question bank clean.
model QuestionReport {
  id         String       @id @default(uuid())
  questionId String       @map("question_id")
  userId     String       @map("user_id")
  reason     ReportReason
  details    String?
  source     String? // where it was reported from, e.g. "mock:<id>" or "contest:<id>"
  status     ReportStatus @default(OPEN)
  createdAt  DateTime     @default(now()) @map("created_at")
  resolvedAt DateTime?    @map("resolved_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([status])
  @@map("question_reports")
}

// Sectional (subject-wise) practice mock test — always available, no rating.
model MockTest {
  id              String   @id @default(uuid())
  title           String
  exam            Exam     @default(SSC_CGL)
  subject         Subject
  durationMinutes Int      @map("duration_minutes")
  negativeMarks   Decimal  @default(0.5) @map("negative_marks")
  isPublished     Boolean  @default(false) @map("is_published")
  createdAt       DateTime @default(now()) @map("created_at")

  mockTestQuestions MockTestQuestion[]
  attempts          MockAttempt[]

  @@map("mock_tests")
}

model MockTestQuestion {
  mockTestId    String  @map("mock_test_id")
  questionId    String  @map("question_id")
  displayOrder  Int     @map("display_order")
  marks         Decimal @default(2)
  negativeMarks Decimal @default(0.5) @map("negative_marks")

  mockTest MockTest @relation(fields: [mockTestId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([mockTestId, questionId])
  @@map("mock_test_questions")
}

model MockAttempt {
  id           String    @id @default(uuid())
  isTest       Boolean   @default(false) @map("is_test")
  userId       String    @map("user_id")
  mockTestId   String    @map("mock_test_id")
  score        Decimal   @default(0)
  totalMarks   Decimal   @default(0) @map("total_marks")
  correctCount Int       @default(0) @map("correct_count")
  wrongCount   Int       @default(0) @map("wrong_count")
  skippedCount Int       @default(0) @map("skipped_count")
  answers      Json?
  timeSpent    Json?     @map("time_spent")
  markedForReview Json?  @map("marked_for_review") // array of question IDs flagged in the room
  language     Language  @default(EN)
  startedAt    DateTime  @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")

  user     User     @relation(fields: [userId], references: [id])
  mockTest MockTest @relation(fields: [mockTestId], references: [id])

  @@unique([userId, mockTestId])
  @@index([mockTestId, isTest])
  @@map("mock_attempts")
}

model ContestQuestion {
  contestId     String  @map("contest_id")
  questionId    String  @map("question_id")
  displayOrder  Int     @map("display_order")
  marks         Decimal @default(2)
  negativeMarks Decimal @default(0.5) @map("negative_marks")

  contest  Contest  @relation(fields: [contestId], references: [id])
  question Question @relation(fields: [questionId], references: [id])

  @@id([contestId, questionId])
  @@map("contest_questions")
}

// `isTest` marks an attempt that must never reach a leaderboard, a rating or a
// public statistic — an admin trying the product out. It is stamped from the
// user's role when the row is written rather than derived from the role at
// read time, so promoting someone to admin later cannot retroactively remove
// their genuine attempts and silently shift everyone else's historical ranks.
model Participation {
  id           String    @id @default(uuid())
  isTest       Boolean   @default(false) @map("is_test")
  userId       String    @map("user_id")
  contestId    String    @map("contest_id")
  score        Decimal   @default(0)
  draftAnswers Json?     @default("{}") @map("draft_answers")
  answers      Json?
  timeSpent    Json?     @map("time_spent")
  markedForReview Json?  @map("marked_for_review") // array of question IDs flagged in the room
  // Chosen when the paper is opened and fixed for the attempt, so the review
  // afterwards reads the same as the exam did.
  language     Language  @default(EN)
  startedAt    DateTime  @default(now()) @map("started_at")
  submittedAt  DateTime? @map("submitted_at")

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  @@unique([userId, contestId])
  @@index([contestId, isTest])
  @@map("participations")
}

model RatingHistory {
  id                String   @id @default(uuid())
  userId            String   @map("user_id")
  contestId         String   @map("contest_id")
  oldRating         Int      @map("old_rating")
  newRating         Int      @map("new_rating")
  rank              Int
  totalParticipants Int      @map("total_participants")
  createdAt         DateTime @default(now()) @map("created_at")

  user    User    @relation(fields: [userId], references: [id])
  contest Contest @relation(fields: [contestId], references: [id])

  @@unique([userId, contestId])
  @@map("rating_history")
}

enum Role {
  STUDENT
  ADMIN
}

enum ContestStatus {
  SCHEDULED
  LIVE
  ENDED
}

/**
 * A reusable label for a question.
 *
 * Normalized on purpose. Topics used to be a free string on `questions`
 * checked against a hard-coded list, which meant renaming one was a data
 * migration and "Time & Work" / "Time and Work" were different topics. A tag
 * is a row: it is renamed in one place, and the join table makes
 * "every question tagged X" an index lookup rather than a LIKE scan.
 *
 * `exam` is null for a tag that applies to any examination (difficulty bands,
 * say); set, for one that only makes sense within a single exam's syllabus.
 */
model Tag {
  id        String      @id @default(uuid())
  name      String
  // Lowercased, hyphenated, unique within a category — the identity used to
  // dedupe on import, so "Time & Work" cannot be created twice.
  slug      String
  category  TagCategory @default(TOPIC)
  exam      Exam?
  // Retired tags stop being offered on new questions but stay attached to the
  // ones that already carry them, so historical filters keep working.
  active    Boolean     @default(true)
  createdAt DateTime    @default(now()) @map("created_at")

  questions QuestionTag[]

  @@unique([category, slug])
  @@index([exam, category, active])
  @@map("tags")
}

model QuestionTag {
  questionId String @map("question_id")
  tagId      String @map("tag_id")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  tag      Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([questionId, tagId])
  @@index([tagId])
  @@map("question_tags")
}

// Sections, across every examination the platform supports. One enum rather
// than one per exam: a question belongs to exactly one section, and keeping
// them together means `sectionLimits`, subject filters and the per-subject
// stats on a profile work for CAT without a parallel code path.
//
// Which members are legal is a function of the exam — see `examSections()` in
// src/lib/exams.ts, which is what validation actually consults.
enum Subject {
  // SSC CGL
  QUANT
  REASONING
  ENGLISH
  GK
  // CAT
  VARC
  DILR
  QA
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

// How a question is answered, which decides how it is rendered and how it is
// marked. STANDARD/SYLLOGISM/PASSAGE/TABLE are all single-choice and store
// their key in `correctOption`; MSQ and TITA store theirs in `answerConfig`.
enum QuestionType {
  STANDARD
  SYLLOGISM
  PASSAGE
  TABLE
  // Multiple correct options. CAT marks these all-or-nothing by default.
  MSQ
  // Type In The Answer: no options at all, the candidate types a number or
  // a word. CAT's non-MCQs carry no negative marking.
  TITA
}

enum Exam {
  SSC_CGL
  CAT
}

// The facet a tag describes. A tag is only ever offered where its category
// fits, so a difficulty tag cannot end up in the topic picker.
enum TagCategory {
  TOPIC
  SUBTOPIC
  DIFFICULTY
  SKILL
  QUESTION_TYPE
  CUSTOM
}

enum ReportReason {
  WRONG_ANSWER
  TYPO
  UNCLEAR
  MULTIPLE_CORRECT
  OTHER
}

enum ReportStatus {
  OPEN
  RESOLVED
  DISMISSED
}

enum NotificationType {
  FOLLOW
  ARTICLE_VOTE
  COMMENT_VOTE
  ANNOUNCEMENT
  // A new contest has been scheduled — sent to everyone.
  CONTEST_ANNOUNCED
  // Your contest starts within the hour — sent to those registered for it.
  CONTEST_STARTING
}

enum ArticleType {
  GENERAL
  ANNOUNCEMENT
  TECHNIQUE
  EDITORIAL
}

enum PassageType {
  TEXT
  TABLE
}

// Language a question or passage can be presented in.
//
// EN is the default and lives in the base columns on Question/Passage, which
// is why no existing row had to be migrated. Every other language is a row in
// the tables below, so adding one is a new enum member — not a column per
// language on a table with hundreds of rows.
enum Language {
  EN
  HI
}

// One row per (question, non-default language).
//
// Deliberately holds only what a reader sees. correctOption, subject,
// difficulty, marks and the fingerprint stay on Question, so a translation
// cannot change what is being asked, only how it reads — which is what keeps a
// Hindi and an English candidate on the same paper.
model QuestionTranslation {
  id             String   @id @default(uuid())
  questionId     String   @map("question_id")
  language       Language
  text           String
  optionA        String   @map("option_a")
  optionB        String   @map("option_b")
  optionC        String   @map("option_c")
  optionD        String   @map("option_d")
  solution       String?
  // Syllogism statements/conclusions, same shape as Question.structuredData.
  structuredData Json?    @map("structured_data")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  question Question @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([questionId, language])
  @@index([language])
  @@map("question_translations")
}

// Reading passages and data tables translate independently of the questions
// that hang off them — one passage typically serves several.
model PassageTranslation {
  id        String   @id @default(uuid())
  passageId String   @map("passage_id")
  language  Language
  title     String   @default("")
  content   String
  tableData Json?    @map("table_data")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  passage Passage @relation(fields: [passageId], references: [id], onDelete: Cascade)

  @@unique([passageId, language])
  @@map("passage_translations")
}
