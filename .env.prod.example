# ── AWS ECR ────────────────────────────────────────────────────────────────────
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789.dkr.ecr.ap-south-1.amazonaws.com

# Set by CI/CD on each deploy (github.sha)
IMAGE_TAG=latest

# ── Backend ────────────────────────────────────────────────────────────────────
# DATABASE_URL is auto-constructed in docker-compose from POSTGRES_* vars below.
# You do NOT need to set DATABASE_URL here.
JWT_SECRET=change-this-to-a-long-random-string-in-production
CORS_ORIGIN=https://rankarena.in,https://admin.rankarena.in

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=rankarena
POSTGRES_USER=rankarena
POSTGRES_PASSWORD=strongpassword

# ── Domains (for reference) ────────────────────────────────────────────────────
# rankarena.in          → student frontend
# admin.rankarena.in    → admin frontend
# api.rankarena.in      → backend API
