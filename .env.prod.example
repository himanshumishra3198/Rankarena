# ── AWS ECR ────────────────────────────────────────────────────────────────────
# Format: <account-id>.dkr.ecr.<region>.amazonaws.com
ECR_REGISTRY=123456789.dkr.ecr.ap-south-1.amazonaws.com

# Set by CI/CD on each deploy (github.sha)
IMAGE_TAG=latest

# ── Backend ────────────────────────────────────────────────────────────────────
# DATABASE_URL is auto-constructed in docker-compose from POSTGRES_* vars below.
# You do NOT need to set DATABASE_URL here.
JWT_SECRET=change-this-to-a-long-random-string-in-production
CORS_ORIGIN=https://rankarenas.com,https://www.rankarenas.com,https://admin.rankarenas.com
# Root of the student site. Verification and password-reset links are built
# from this, so a wrong value produces emails whose links go nowhere.
PUBLIC_SITE_URL=https://rankarenas.com

# ── Outbound email (Amazon SES SMTP) ───────────────────────────────────────────
# From SES → SMTP settings → "Create SMTP credentials". These are NOT your AWS
# access keys; SES derives a separate user/password pair for SMTP.
# Leave SMTP_HOST empty to disable sending — links are then written to the
# backend container log, which is useful before SES is set up.
SMTP_HOST=email-smtp.us-east-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Must be an address or domain you have verified in SES, or every send fails.
# This has to stay on rankarenas.com — SES will not let you send as an address
# on a domain you do not control, and receivers would treat it as spoofing.
MAIL_FROM=RankArenas <no-reply@rankarenas.com>
# Where replies land. Any address, including a Gmail one — it is never used to
# send, so no SPF/DKIM/SES verification applies to it. Leave empty to send
# genuinely unanswerable mail.
MAIL_REPLY_TO=rrankarenas@gmail.com

# ── Google sign-in ─────────────────────────────────────────────────────────────
# OAuth 2.0 Web client id from Google Cloud Console. Must match the
# VITE_GOOGLE_CLIENT_ID the frontend bundle was built with. The client secret
# is not used by this flow — do not put it here.
GOOGLE_CLIENT_ID=

# ── PostgreSQL ─────────────────────────────────────────────────────────────────
POSTGRES_DB=rankarena
POSTGRES_USER=rankarena
POSTGRES_PASSWORD=strongpassword

# ── Domains (for reference) ────────────────────────────────────────────────────
# rankarenas.com        → student frontend (www.rankarenas.com 301s to apex)
# admin.rankarenas.com  → admin frontend
# api.rankarenas.com    → backend API

# Baked into the frontend/admin bundles at build time (GitHub Actions secret
# VITE_API_URL must match this).
VITE_API_URL=https://api.rankarenas.com
